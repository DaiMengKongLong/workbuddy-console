#!/bin/bash
# WorkBuddy 控制台 · fnOS —— 生命周期主控
# start / stop / status

# fnOS 应用中心提供的 Node.js v22（manifest: install_dep_apps = nodejs_v22）
# 运行时：优先用包内自带的 Node（零依赖安装），其次应用中心的 nodejs_v22，最后系统 node
APP_NODE="${TRIM_APPDEST}/runtime/bin/node"
if [ -f "$APP_NODE" ]; then chmod +x "$APP_NODE" 2>/dev/null || true; fi
if [ -x "$APP_NODE" ]; then
    NODE_BIN="$APP_NODE"
elif [ -x /var/apps/nodejs_v22/target/bin/node ]; then
    NODE_BIN=/var/apps/nodejs_v22/target/bin/node
else
    NODE_BIN="$(command -v node || echo /usr/bin/node)"
fi
export PATH=$(dirname "$NODE_BIN"):$PATH

DATA_DIR="${TRIM_PKGVAR}/data"
RUN_DIR="${TRIM_PKGVAR}/run"
LOG_DIR="${TRIM_PKGVAR}/logs"
LOG_FILE="${LOG_DIR}/console.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
PORT="${TRIM_SERVICE_PORT:-57891}"
APP_DEST="${TRIM_APPDEST:-/var/apps/wbconsole/target}"

export HOME="${TRIM_PKGVAR}/home"
export FREE_TOKEN_CONFIG_DIR="${TRIM_PKGVAR}/data/config"
mkdir -p "${DATA_DIR}" "${RUN_DIR}" "${LOG_DIR}" "${HOME}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

status() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

start_process() {
    if status; then
        log_msg "already running"
        return 0
    fi

    # 端口被占用时顺延，避免启动失败
    if (command -v ss >/dev/null 2>&1 && ss -ltn | grep -q ":${PORT} ") ; then
        log_msg "port ${PORT} busy, fallback to 57892"
        PORT=57892
    fi

    log_msg "starting on port ${PORT} (node: $(command -v node || echo missing))"
    cd "${APP_DEST}" || { log_msg "cannot cd ${APP_DEST}"; exit 1; }

    WBCONSOLE_DATA_DIR="${DATA_DIR}" \
    WBCONSOLE_PORT="${PORT}" \
    WBCONSOLE_HOST="0.0.0.0" \
    WBCONSOLE_SOCK="${RUN_DIR}/wbconsole.sock" \
    NODE_ENV=production \
        "$NODE_BIN" server/index.mjs >> "${LOG_FILE}" 2>&1 &

    echo $! > "${PID_FILE}"
    # 记录实际端口，供 CGI 桥接读取（端口被占用顺延时不会走错）
    echo "${PORT}" > "${RUN_DIR}/port"
    sleep 1
    if ! status; then
        log_msg "start failed, see ${LOG_FILE}"
        exit 1
    fi
    log_msg "started pid=$(cat "${PID_FILE}")"
    return 0
}

stop_process() {
    log_msg "stopping"
    if [ -r "${PID_FILE}" ]; then
        local pid
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return 0
        fi
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ ${count} -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        if check_process "${pid}"; then
            kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
            sleep 1
        fi
        rm -f "${PID_FILE}"
    fi
    log_msg "stopped"
    return 0
}

case "$1" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
